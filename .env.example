# --- MySQL (XAMPP defaults shown) ---
# Default XAMPP MySQL has root user with NO password on port 3306.
# Create the database first in phpMyAdmin: e.g. `monarque_limo`
DATABASE_URL="mysql://root:@localhost:3306/monarque_limo"

# --- Auth ---
JWT_SECRET="change-this-to-a-long-random-string"

# --- Seeded admin login (used by prisma/seed.js) ---
ADMIN_EMAIL="admin@monarquelimo.com"
ADMIN_PASSWORD="ChangeMe123!"

# --- SMTP (booking confirmation emails) ---
# Any SMTP provider works (Gmail app password, SendGrid, Mailgun, etc).
# Leave as-is during local dev if you don't want emails to actually send yet —
# the API will log a warning and continue instead of crashing.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Monarque Limo <no-reply@monarquelimo.com>"
NOTIFY_EMAIL="owner@monarquelimo.com"

# --- App ---
NEXT_PUBLIC_SITE_NAME="Monarque Limo"
